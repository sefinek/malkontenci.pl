<!DOCTYPE html> <% const _basePath = locals.canonical || '/'; %>
<html lang="pl">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= title %></title>

	<!-- Primary meta -->
	<% if (locals.description) { %><meta name="description" content="<%= description %>"><% }
	if (locals.keywords) { %><meta name="keywords" content="<%= keywords %>"><% }
	if (locals.noindex) { %><meta name="robots" content="noindex"><% }
	if (locals.canonical) { %><link rel="canonical" href="<%= domain %><%= _basePath %>"><% } %>
	<meta name="theme-color" content="#161513">
	<link rel="icon" href="/favicon.ico" sizes="48x48">
	<link rel="icon" href="/favicon.svg" type="image/svg+xml">
	<link rel="apple-touch-icon" href="/apple-touch-icon.png">
	<link rel="manifest" href="/manifest.json">

	<!-- Open Graph -->
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="malkontenci.pl">
	<meta property="og:locale" content="pl_PL">
	<meta property="og:title" content="<%= title %>">
	<% if (locals.description) { %><meta property="og:description" content="<%= description %>"><% } %>
	<meta property="og:url" content="<%= domain %><%= _basePath %>">
	<meta property="og:image" content="<%= domain %>/images/brand/icon-bg-512.png">
	<meta property="og:image:type" content="image/png">
	<meta property="og:image:width" content="512">
	<meta property="og:image:height" content="512">
	<meta property="og:image:alt" content="Logo malkontenci.pl">

	<!-- Twitter / X Card -->
	<meta name="twitter:card" content="summary">
	<meta name="twitter:title" content="<%= title %>">
	<% if (locals.description) { %><meta name="twitter:description" content="<%= description %>"><% } %>
	<meta name="twitter:image" content="<%= domain %>/images/brand/icon-bg-512.png">
	<meta name="twitter:image:alt" content="Logo malkontenci.pl">

	<!-- JavaScript -->
	<script src="https://cdn.sefinek.net/js/progressbar.js" defer></script>

	<!-- Stylesheets -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&amp;family=Work+Sans:wght@400;500;600;700&amp;display=swap">
	<link rel="stylesheet" href="/css/global.css">
	<% if (locals.css) { (Array.isArray(css) ? css : [css]).forEach(c => { %><link rel="stylesheet" href="/css/<%= c %>.css" data-page-css><% }) } %>

	<% if (_basePath === '/') { %><!-- schema.org -->
	<script type="application/ld+json" data-seo>
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"name": "malkontenci.pl",
		"url": "<%= domain %>",
		"description": "Test diagnostyczny sprawdzający, czy jesteś malkontentem. Po ukończeniu testu otrzymasz także certyfikat. Krajowa Poradnia Antyfrustracyjna pozdrawia.",
		"inLanguage": "pl-PL"
	}
	</script><% } %>
</head>
<body data-page="<%= locals.page || '' %>">
<audio id="bg-music" src="/sound/oblivion-harvest-dawn.mp3" autoplay muted preload="none"></audio>

<header>
	<a id="logo" class="logo" href="/" aria-label="Malkontenci.pl - strona główna"><img class="logo-icon" src="/images/brand/icon.svg" alt="" width="42" height="42">MALKONTENCI<span>.PL</span></a>
	<nav class="header-actions" aria-label="Menu główne">
		<a class="nav-link" href="/moje-certyfikaty">Moje certyfikaty</a>
		<div class="sound-toggle">
			<button id="sound-btn" type="button">
				<span id="sound-label">Włącz muzykę</span>
			</button>
		</div>
	</nav>
	<div class="clinic-name">Krajowa Poradnia Antyfrustracyjna</div>
</header>
